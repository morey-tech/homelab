          "expr": "((sysUptime{job=\"qnap\",instance=\"qnap-01\"} and (time() - timestamp(sysUptime{job=\"qnap\",instance=\"qnap-01\"}) < 180))) and on(job, instance) ((up{job=\"qnap\",instance=\"qnap-01\"} and (time() - timestamp(up{job=\"qnap\",instance=\"qnap-01\"}) < 180)) == 1)",
          "instant": true,
          "range": false,
          "legendFormat": "",

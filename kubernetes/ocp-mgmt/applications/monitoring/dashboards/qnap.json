          "expr": "((8 * rate(ifHCInOctets{job=\"qnap\",instance=\"qnap-01\",ifName=~\"(eth|bond)[0-9]+([.][0-9]+)?\"}[5m])) and (ifHCInOctets{job=\"qnap\",instance=\"qnap-01\"} and (time() - timestamp(ifHCInOctets{job=\"qnap\",instance=\"qnap-01\"}) < 180))) and on(job, instance) ((up{job=\"qnap\",instance=\"qnap-01\"} and (time() - timestamp(up{job=\"qnap\",instance=\"qnap-01\"}) < 180)) == 1)",
          "instant": false,
          "range": true,
          "legendFormat": "{{ifName}} ({{ifIndex}})",

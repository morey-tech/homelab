{
  "uid": "qnap-overview",
  "title": "QNAP Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "homelab",
    "infrastructure",
    "qnap"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "SNMP collection",
      "type": "stat",
      "description": "Collection status only, not NAS health. Unknown when telemetry is missing or older than 180 seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "infrastructure"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                },
                "0": {
                  "text": "Failed",
                  "color": "red"
                },
                "1": {
                  "text": "Collecting",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "infrastructure"
          },
          "expr": "(up{job=\"qnap\",instance=\"qnap-01\"} and (time() - timestamp(up{job=\"qnap\",instance=\"qnap-01\"}) < 180)) or on() vector(-1)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "NAS uptime",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "infrastructure"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4

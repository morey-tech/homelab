    {
      "id": 22,
      "title": "Network receive",
      "type": "timeseries",
      "description": "Five-minute average bits per second from 64-bit interface byte counters. Shows Ethernet ports, bonds, and their VLANs individually. Do not sum these lines: traffic can appear on both a bond and its member ports or VLANs. Loopback and virtual bridges are excluded. Requires at least two samples; failed or stale collection appears as gaps.",
      "datasource": {
        "type": "prometheus",
        "uid": "infrastructure"
      },
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "noValue": "Unknown",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"

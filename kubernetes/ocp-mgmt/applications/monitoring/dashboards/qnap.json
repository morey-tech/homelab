      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unknown",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "infrastructure"
          },
          "expr": "((storagepoolCapacity{job=\"qnap\",instance=\"qnap-01\"} and (time() - timestamp(storagepoolCapacity{job=\"qnap\",instance=\"qnap-01\"}) < 180)) - (storagepoolFreeSize{job=\"qnap\",instance=\"qnap-01\"} and (time() - timestamp(storagepoolFreeSize{job=\"qnap\",instance=\"qnap-01\"}) < 180))) and on(job, instance) ((up{job=\"qnap\",instance=\"qnap-01\"} and (time() - timestamp(up{job=\"qnap\",instance=\"qnap-01\"}) < 180)) == 1)",
          "instant": false,
          "range": true,
          "legendFormat": "Pool {{pool_id}}",
          "editorMode": "code"

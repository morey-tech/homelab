    {
      "id": 6,
      "title": "DNS / HTTPS duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "infrastructure"
      },
      "description": "Whole probe duration including failed-probe timeouts. This is not ICMP round-trip latency.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "Unknown",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"internet_services\"} and (up{job=\"internet_services\"} == 1) and (time() - timestamp(probe_duration_seconds{job=\"internet_services\"}) < 30)",
          "legendFormat": "{{target}}",
          "datasource": {
            "type": "prometheus",
            "uid": "infrastructure"
          },
          "range": true,
          "instant": false,
          "interval": "1m"

    {
      "id": 11,
      "title": "WAN upload",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "infrastructure"
      },
      "description": "Existing pfSense ix2 WAN counters, five-minute average. Compare with loss and latency to identify possible link saturation.",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "noValue": "Unknown",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "infrastructure"
          },
          "expr": "((((8 * rate(ifHCOutOctets{job=\"pfsense\",instance=\"pfsense\",ifName=~\"ix2\"}[5m])) and (ifHCOutOctets{job=\"pfsense\",instance=\"pfsense\",ifName=~\"ix2\"} and (time() - timestamp(ifHCOutOctets{job=\"pfsense\",instance=\"pfsense\",ifName=~\"ix2\"}) < 180))) and on(job, instance) ((up{job=\"pfsense\",instance=\"pfsense\"} and (time() - timestamp(up{job=\"pfsense\",instance=\"pfsense\"}) < 180)) == 1)) * on(job, instance, ifIndex, ifName) group_left(interface) label_join((ifAlias{job=\"pfsense\",instance=\"pfsense\",ifAlias!=\"\"} and (time() - timestamp(ifAlias{job=\"pfsense\",instance=\"pfsense\",ifAlias!=\"\"}) < 180)), \"interface\", \" \u00b7 \", \"ifAlias\", \"ifName\")) or on(job, instance, ifIndex, ifName) label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace((((8 * rate(ifHCOutOctets{job=\"pfsense\",instance=\"pfsense\",ifName=~\"ix2\"}[5m])) and (ifHCOutOctets{job=\"pfsense\",instance=\"pfsense\",ifName=~\"ix2\"} and (time() - timestamp(ifHCOutOctets{job=\"pfsense\",instance=\"pfsense\",ifName=~\"ix2\"}) < 180))) and on(job, instance) ((up{job=\"pfsense\",instance=\"pfsense\"} and (time() - timestamp(up{job=\"pfsense\",instance=\"pfsense\"}) < 180)) == 1)), \"interface\", \"$1\", \"ifName\", \"(.*)\"), \"interface\", \"WAN \\u00b7 $1\", \"ifName\", \"(ix2)\"), \"interface\", \"LAN \\u00b7 $1\", \"ifName\", \"(lagg0)\"), \"interface\", \"LAB \\u00b7 $1\", \"ifName\", \"(lagg0\\\\.3)\"), \"interface\", \"RH_LAB \\u00b7 $1\", \"ifName\", \"(lagg0\\\\.6)\"), \"interface\", \"NETBOOT \\u00b7 $1\", \"ifName\", \"(lagg0\\\\.8)\"), \"interface\", \"IOT \\u00b7 $1\", \"ifName\", \"(lagg0\\\\.20)\"), \"interface\", \"WireGuard \\u00b7 $1\", \"ifName\", \"(tun_wg0)\"), \"interface\", \"Tailscale \\u00b7 $1\", \"ifName\", \"(tailscale0)\")",
          "legendFormat": "{{interface}}",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "interval": "1m"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "title": "WAN download",

          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Loss by minute",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "infrastructure"
      },
      "description": "0: below 5% loss; 1: at least 5%; 2: at least 99%. Gaps are unknown, not healthy.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Unknown",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "showPoints": "never"
          },
          "max": 2,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "<5% loss",
                  "color": "green"
                },
                "1": {
                  "text": "Degraded \u22655%",
                  "color": "orange"
                },
                "2": {
                  "text": "Unreachable \u226599%",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(internet:ping_loss:ratio1m >= bool 0.05) + (internet:ping_loss:ratio1m >= bool 0.99)",
          "legendFormat": "{{target}}",
          "datasource": {
            "type": "prometheus",
            "uid": "infrastructure"
          },
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "title": "Valid measurement coverage \u2014 rolling 24 hours",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "infrastructure"
      },
      "description": "Valid one-minute observations divided by 1440 expected minutes. Starts below 100% during the first day. A missing series is unknown. Interpret every daily statistic alongside coverage.",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "Unknown",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "showPoints": "never"
          },
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * count_over_time(internet:ping_loss:ratio1m[24h]) / 1440",
          "legendFormat": "{{target}} ping",
          "datasource": {
            "type": "prometheus",
            "uid": "infrastructure"
          },
          "range": true,
          "instant": false,
          "interval": "1m"
        },
        {
          "refId": "B",
          "expr": "100 * count_over_time(internet:service_success:ratio1m[24h]) / 1440",
          "legendFormat": "{{target}}",
          "datasource": {
            "type": "prometheus",
            "uid": "infrastructure"
          },
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },

        "type": "prometheus",
        "uid": "infrastructure"
      },
      "description": "Histogram estimate over five minutes, for replies received only. Lost packets have no latency. The local pfSense baseline includes the pod and cluster network path.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {

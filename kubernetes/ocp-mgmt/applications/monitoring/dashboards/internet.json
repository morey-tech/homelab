{
  "uid": "internet-quality",
  "title": "Internet Quality",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "homelab",
    "infrastructure",
    "internet"
  ],
  "description": "IPv4 quality from ocp-mgmt. Local baseline, independent external targets, DNS/HTTPS checks, pfSense WAN traffic and Hitron modem telemetry. Unknown monitoring intervals remain gaps.",
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Packet loss \u2014 one minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "infrastructure"
      },
      "description": "Estimated ICMP round-trip loss from sent/received counter rates. One ping/s per target. Local socket errors, stopped sending, restarts and missing scrapes are unknown. Late replies can cross window boundaries; loss is clamped to 0\u2013100%.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "Unknown",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "showPoints": "never"
          },
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * internet:ping_loss:ratio1m",
          "legendFormat": "{{target}}",
          "datasource": {
            "type": "prometheus",
            "uid": "infrastructure"
          },
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "Packet loss \u2014 five minutes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "infrastructure"
      },
      "description": "Mean of five complete one-minute observations; a missing minute creates a gap.",
      "gridPos": {

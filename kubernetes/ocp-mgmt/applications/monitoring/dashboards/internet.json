    {
      "id": 13,
      "title": "DNS / HTTPS reachability by target",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "infrastructure"
      },
      "description": "Compare concurrent failures across targets and with the LAN/ping baseline. 0: all probes failed; 1: some failed; 2: all succeeded. Missing collection remains a gap. Targets sharing a provider are not independent votes: Google/YouTube, Amazon/AWS, Quay/Red Hat, and the two Plex endpoints may share infrastructure. Registry authentication challenges and expected AWS API errors count as reachable.",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Unknown",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "showPoints": "never"
          },
          "max": 2,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Probe failed",
                  "color": "red"
                },
                "1": {

    {
      "title": "Node network receive",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ocp-home"
      },
      "description": "Five-minute average bits/s per node and interface. bond0 only; its physical members are excluded to avoid counting traffic twice. Rates handle counter resets and require two samples. Failed scrapes or samples older than 180 seconds show gaps; idle interfaces remain zero. No cluster traffic total is inferred.",

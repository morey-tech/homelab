  "panels": [
    {
      "title": "Cluster health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ocp-home"
      },
      "description": "Healthy: 1 expected nodes Ready, no operator problems or critical/warning alerts. Attention: warnings or progressing operators. Unhealthy: missing/unready nodes, unavailable/degraded/failing operators, or critical alerts. Unknown: required monitoring sources or Watchdog missing/down/stale (>180 seconds). Query errors must be treated as unknown.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(clamp_max(2 * (clamp_max(((sum(max by (node) ((kube_node_status_condition{condition=\"Ready\",status=\"true\",node=~\"ocp\\\\-home\\\\-01\\\\.rh\\\\-lab\\\\.morey\\\\.tech\"} and (time() - timestamp(kube_node_status_condition{condition=\"Ready\",status=\"true\",node=~\"ocp\\\\-home\\\\-01\\\\.rh\\\\-lab\\\\.morey\\\\.tech\"}) < 180)))) or vector(0)) != bool 1) + ((count(count by (name) (cluster_operator_conditions{condition=\"Available\"} == 0 or cluster_operator_conditions{condition=~\"Degraded|Failing\"} == 1)) or vector(0)) > bool 0) + ((count(ALERTS{alertstate=\"firing\",severity=\"critical\"}) or vector(0)) > bool 0), 1)) + (clamp_max(((count(ALERTS{alertstate=\"firing\",severity=\"warning\"}) or vector(0)) > bool 0) + ((count(cluster_operator_conditions{condition=\"Progressing\"} == 1) or vector(0)) > bool 0), 1)), 2) and on() ((max((up{job=\"kube-state-metrics\",endpoint=\"https-main\"} and (time() - timestamp(up{job=\"kube-state-metrics\",endpoint=\"https-main\"}) < 180))) == 1) and on() (max((up{job=\"cluster-version-operator\"} and (time() - timestamp(up{job=\"cluster-version-operator\"}) < 180))) == 1) and on() (max((up{job=\"prometheus-k8s\"} and (time() - timestamp(up{job=\"prometheus-k8s\"}) < 180))) == 1) and on() (max((ALERTS{alertname=\"Watchdog\",alertstate=\"firing\"} and (time() - timestamp(ALERTS{alertname=\"Watchdog\",alertstate=\"firing\"}) < 180))) == 1) and on() (count((cluster_operator_conditions{condition=\"Available\"} and (time() - timestamp(cluster_operator_conditions{condition=\"Available\"}) < 180))) > 0))) or vector(-1)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "ocp-home"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                },
                "0": {
                  "text": "Healthy",
                  "color": "green"
                },
                "1": {
                  "text": "Attention",
                  "color": "yellow"
                },
                "2": {
                  "text": "Unhealthy",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto",
        "justifyMode": "auto"
      },
      "id": 1
    },

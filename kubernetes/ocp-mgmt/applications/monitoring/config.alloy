logging {
	level  = "info"
	format = "logfmt"
}

// Projected Secret updates are picked up without a pod restart. Mark the
// complete auth document secret so Alloy's UI does not expose credentials.
local.file "qnap_auth" {
	filename       = "/etc/alloy-secrets/qnap/snmp-auth.yml"
	is_secret      = true
	detector       = "poll"
	poll_frequency = "1m"
}

local.file "qnap_module" {
	filename = "/etc/alloy/qnap-snmp.yml"
}

prometheus.exporter.snmp "qnap" {
	config = local.file.qnap_auth.content + "\n" + local.file.qnap_module.content

	target "qnap_01" {
		address = "192.168.6.20"
		module  = "qnap_qutshero"
		auth    = "qnap_v3"
		labels  = {nas = "qnap-01"}
	}

	target "qnap_02" {
		address = "qnap-02.taile3c3a8.ts.net"
		module  = "qnap_qutshero"
		auth    = "qnap_v3"
		labels  = {nas = "qnap-02"}
	}
}

discovery.relabel "qnap" {
	targets = prometheus.exporter.snmp.qnap.targets

	rule {
		target_label = "job"
		replacement  = "qnap"
	}

	// The exporter supplies its own instance label. Assign the NAS identity
	// afterwards so different targets cannot collapse into the same series.
	rule {
		source_labels = ["nas"]
		target_label  = "instance"
	}

	rule {
		action = "labeldrop"
		regex  = "nas"
	}
}

prometheus.scrape "qnap" {
	targets         = discovery.relabel.qnap.output
	scrape_interval = "60s"
	scrape_timeout  = "55s"
	forward_to      = [prometheus.remote_write.infrastructure.receiver]
}

local.file "mikrotik_auth" {
	filename       = "/etc/alloy-secrets/mikrotik/snmp-auth.yml"
	is_secret      = true
	detector       = "poll"
	poll_frequency = "1m"
}

local.file "mikrotik_module" {
	filename = "/etc/alloy/mikrotik-snmp.yml"
}

prometheus.exporter.snmp "mikrotik" {
	config = local.file.mikrotik_auth.content + "\n" + local.file.mikrotik_module.content

	target "crs317_a" {
		address = "192.168.1.15"
		module  = "mikrotik_routeros"
		auth    = "mikrotik_v3"
		labels  = {switch = "crs317-a"}
	}

	target "crs317_b" {
		address = "192.168.1.16"
		module  = "mikrotik_routeros"
		auth    = "mikrotik_v3"
		labels  = {switch = "crs317-b"}
	}
}

discovery.relabel "mikrotik" {
	targets = prometheus.exporter.snmp.mikrotik.targets

	rule {
		target_label = "job"
		replacement  = "mikrotik"
	}

	rule {
		source_labels = ["switch"]
		target_label  = "instance"
	}

	rule {
		action = "labeldrop"
		regex  = "switch"
	}
}

prometheus.scrape "mikrotik" {
	targets         = discovery.relabel.mikrotik.output
	scrape_interval = "60s"
	scrape_timeout  = "30s"
	forward_to      = [prometheus.remote_write.infrastructure.receiver]
}

local.file "pfsense_auth" {
	filename       = "/etc/alloy-secrets/pfsense/snmp-auth.yml"
	is_secret      = true
	detector       = "poll"
	poll_frequency = "1m"
}

local.file "pfsense_module" {
	filename = "/etc/alloy/pfsense-snmp.yml"
}

prometheus.exporter.snmp "pfsense" {
	config = local.file.pfsense_auth.content + "\n" + local.file.pfsense_module.content

	target "pfsense" {
		address = "192.168.6.1:161"
		module  = "pfsense"
		auth    = "pfsense_v3"
	}
}

discovery.relabel "pfsense" {
	targets = prometheus.exporter.snmp.pfsense.targets

	rule {
		target_label = "job"
		replacement  = "pfsense"
	}

	rule {
		target_label = "instance"
		replacement  = "pfsense"
	}
}

prometheus.scrape "pfsense" {
	targets         = discovery.relabel.pfsense.output
	scrape_interval = "60s"
	scrape_timeout  = "30s"
	forward_to      = [prometheus.remote_write.infrastructure.receiver]
}

// Only aggregate counts are exported; API credentials stay in the exporter.
prometheus.scrape "tautulli" {
	targets = [{
		__address__      = "tautulli-exporter.monitoring.svc:7979",
		__param_module   = "activity",
		__param_target   = "https://tautulli.apps.ocp-home.rh-lab.morey.tech/api/v2?cmd=get_activity",
		job              = "tautulli",
		instance         = "plex",
	}]
	metrics_path    = "/probe"
	scrape_interval = "30s"
	scrape_timeout  = "20s"
	forward_to      = [prometheus.remote_write.infrastructure.receiver]
}

prometheus.remote_write "infrastructure" {
	endpoint {
		url = "http://prometheus.monitoring.svc:9090/api/v1/write"
	}
}

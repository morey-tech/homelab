{
  "tagOwners": {
    "tag:ocp-home-api": ["autogroup:admin"],
    "tag:ocp-home-proxy": ["tag:ocp-home-api"]
  },
  "grants": [
    {
      "src": ["autogroup:member", "autogroup:tagged"],
      "dst": ["tag:ocp-home-api"],
